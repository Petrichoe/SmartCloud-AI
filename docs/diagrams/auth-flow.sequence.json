    { "participant": "gateway", "from": 190, "to": 395, "type": "security" },
    { "participant": "gateway", "from": 447, "to": 582, "type": "security" },
    { "participant": "gateway", "from": 636, "to": 756, "type": "security" },
    { "participant": "gateway", "from": 810, "to": 902, "type": "security" },
    { "participant": "auth", "from": 226, "to": 392, "type": "backend" },
    { "participant": "auth", "from": 668, "to": 756, "type": "backend" },
    { "participant": "auth", "from": 840, "to": 902, "type": "backend" },
    { "participant": "user", "from": 264, "to": 312, "type": "backend" },
    { "participant": "redis", "from": 338, "to": 352, "type": "database" },
    { "participant": "redis", "from": 704, "to": 718, "type": "database" },
    { "participant": "redis", "from": 870, "to": 884, "type": "database" },
    { "participant": "svc", "from": 490, "to": 546, "type": "backend" }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "双 token 分工",
      "items": [
        "access-token 无状态：网关用 /jwks 公钥本地验签，不查任何存储",
        "refresh-token 有状态：HttpOnly Cookie 防 XSS，jti 存 Redis jwt:uid:{userId}",
        "payload 仅 { userId, roleId, rememberMe }，roleId 不透传下游"
      ]
    },
    {
      "dot": "amber",
      "title": "网关与下游的分工",
      "items": [
        "AccountAuthFilter（order=1000）验签一次，注入 user-info / token-info 头",
        "StripPrefix=1（order=1）先执行，白名单匹配去前缀后的路径",
        "下游 UserInfoInterceptor 读头写 UserContext，LoginAuthInterceptor 401 兜底"
      ]
    },
    {
      "dot": "rose",
      "title": "吊销与取舍",
      "items": [
        "退出登录删除 Redis jti，旧 refresh-token 立即失效",
        "重新登录覆盖 jti，同账号旧会话被顶掉",
        "access-token 在 TTL 内无法主动作废，故 TTL 设计得较短（当前测试值 30 天）"
      ]
    }
  ]
}
