  "participants": [
    { "id": "browser", "type": "frontend", "label": "前端", "sublabel": "tj-portal" },
    { "id": "gateway", "type": "security", "label": "网关", "sublabel": "tj-gateway" },
    { "id": "auth", "type": "backend", "label": "认证服务", "sublabel": "auth-service" },
    { "id": "user", "type": "backend", "label": "用户服务", "sublabel": "user-service" },
    { "id": "redis", "type": "database", "label": "Redis", "sublabel": "jti 缓存" },
    { "id": "svc", "type": "backend", "label": "下游服务", "sublabel": "learning-service 等" }
  ],
  "segments": [
    { "from": 160, "to": 412, "label": "① 登录 · 发证" },
    { "from": 424, "to": 600, "label": "② 业务请求 · 用证" },
    { "from": 612, "to": 780, "label": "③ 刷新 · 换证" },
    { "from": 792, "to": 932, "label": "④ 退出 · 吊销" }
  ],
  "messages": [
    { "id": "login-post", "from": "browser", "to": "gateway", "y": 195, "label": "POST /as/accounts/login", "note": "网关白名单放行，不验 token", "variant": "default" },
    { "id": "login-forward", "from": "gateway", "to": "auth", "y": 232, "label": "转发 POST /accounts/login", "variant": "default" },
    { "id": "feign-query", "from": "auth", "to": "user", "y": 270, "label": "Feign 查询用户身份", "note": "BCrypt 验密 · 冻结校验 · 端别校验", "variant": "emphasis" },
    { "id": "user-detail", "from": "user", "to": "auth", "y": 306, "label": "LoginUserDTO { userId, roleId, rememberMe }", "variant": "return" },
    { "id": "jti-write", "from": "auth", "to": "redis", "y": 344, "label": "写 jti → jwt:uid:{userId}", "note": "TTL 与 refresh-token 一致（7 天 / 30 分钟）", "variant": "security" },
    { "id": "login-response", "from": "auth", "to": "browser", "y": 386, "label": "access-token（响应体）+ refresh Cookie（HttpOnly）", "note": "前端把 access-token 存入 sessionStorage", "variant": "return" },
    { "id": "biz-request", "from": "browser", "to": "gateway", "y": 452, "label": "GET /ls/lessons/now + authorization", "note": "axios 拦截器附加裸 JWT（无 Bearer 前缀）", "variant": "emphasis" },
    { "id": "biz-forward", "from": "gateway", "to": "svc", "y": 496, "label": "转发 + user-info / token-info 头", "note": "AccountAuthFilter 公钥验签；StripPrefix → /lessons/now", "variant": "emphasis" },
    { "id": "biz-handle", "from": "svc", "to": "gateway", "y": 540, "label": "查库返回课程表", "note": "UserInfoInterceptor → UserContext；LoginAuthInterceptor 401 兜底", "variant": "return" },
    { "id": "biz-response", "from": "gateway", "to": "browser", "y": 576, "label": "200 响应", "variant": "return" },
    { "id": "refresh-request", "from": "browser", "to": "gateway", "y": 640, "label": "GET /as/accounts/refresh（401 触发）", "note": "浏览器自动携带 refresh Cookie", "variant": "default" },
    { "id": "refresh-forward", "from": "gateway", "to": "auth", "y": 674, "label": "转发（白名单放行）", "variant": "default" },
    { "id": "jti-check", "from": "auth", "to": "redis", "y": 710, "label": "比对 jti，通过则写入新 jti", "variant": "security" },
    { "id": "refresh-response", "from": "auth", "to": "browser", "y": 750, "label": "新双 token → 重放原请求", "variant": "return" },
    { "id": "logout-request", "from": "browser", "to": "gateway", "y": 812, "label": "POST /as/accounts/logout", "variant": "default" },
    { "id": "logout-forward", "from": "gateway", "to": "auth", "y": 844, "label": "转发（需登录）", "variant": "default" },
    { "id": "jti-delete", "from": "auth", "to": "redis", "y": 876, "label": "删除 jwt:uid:{userId}", "note": "refresh-token 立即作废", "variant": "security" },
    { "id": "logout-response", "from": "auth", "to": "browser", "y": 896, "label": "删除 Cookie，回到登录页", "variant": "return" }
  ],
  "activations": [
